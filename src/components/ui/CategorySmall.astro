---
const { collection } = Astro.props
---

<a

href={`/collections/${collection.slug}`}

class="
md:col-span-1
border
border-theme-base-600
text-theme-base-600
rounded-2xl
p-6
flex
flex-col
items-center
text-center
hover:shadow-lg
transition
"

>

<img

src={collection.imageUrl}

class="
w-20
object-contain
mb-4
"

/>


<h2 class="h4 text-primary-500">

{collection.name}

</h2>

</a>